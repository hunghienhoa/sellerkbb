rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function currentUser() {
      return get(currentUserPath()).data;
    }

    function isAdmin() {
      return signedIn() && exists(currentUserPath()) && currentUser().role == 'admin';
    }

    function hasPermission(permission) {
      return isAdmin() || (
        signedIn() &&
        exists(currentUserPath()) &&
        currentUser().status == 'approved' &&
        currentUser().permissions.hasAny([permission])
      );
    }

    function isBootstrapUserCreate(uid) {
      return signedIn()
        && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/system/bootstrap)
        && getAfter(/databases/$(database)/documents/system/bootstrap).data.adminUid == uid
        && request.resource.data.role == 'admin'
        && request.resource.data.status == 'approved';
    }

    match /system/bootstrap {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/system/bootstrap)
        && request.resource.data.adminUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && (
        isBootstrapUserCreate(uid) || (
          request.resource.data.role == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.permissions.size() == 0
          && request.resource.data.email == request.auth.token.email
        )
      );

      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'displayName', 'photoURL', 'lastLoginAt', 'updatedAt'
        ])
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.permissions == resource.data.permissions
      );

      allow delete: if isAdmin();
    }

    match /liveSessions/{liveId} {
      allow read: if hasPermission('live.read') || hasPermission('kpi.read');
      allow create, update, delete: if isAdmin();
    }

    // Dedicated restricted paths. Operators cannot modify liveSessions, KPI or GMV.
    function canTagAndDraft() {
      return isAdmin() || (
        signedIn() && exists(currentUserPath()) &&
        currentUser().status == 'approved' &&
        currentUser().role in ['operator', 'host'] &&
        currentUser().permissions.hasAll(['live.read', 'live.assign'])
      );
    }

    function validAssignment(liveId) {
      let a = request.resource.data;
      return a.keys().hasOnly([
        'liveId', 'kpiMode', 'manualKpiType', 'hostUid', 'hostName',
        'operatorUid', 'operatorName', 'updatedAt', 'updatedBy'
      ]) && a.keys().hasAll([
        'liveId', 'kpiMode', 'manualKpiType', 'hostUid', 'hostName',
        'operatorUid', 'operatorName', 'updatedAt', 'updatedBy'
      ])
      && a.liveId == liveId && a.updatedBy == request.auth.uid
      && a.updatedAt is timestamp
      && a.kpiMode in ['auto','manual']
      && a.manualKpiType is string
      && a.hostUid is string && a.hostName is string
      && a.operatorUid is string && a.operatorName is string
      && a.hostUid.size() <= 128 && a.operatorUid.size() <= 128
      && a.hostName.size() <= 160 && a.operatorName.size() <= 160
      && ((a.kpiMode == 'manual' &&
           a.manualKpiType in ['campaign','mega'] &&
           a.hostUid == '' && a.hostName == '' &&
           a.operatorUid == '' && a.operatorName == '')
         || (a.kpiMode == 'auto' && a.manualKpiType == ''));
    }

    function validDelegatedDraft(liveId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['liveId','entries','status','updatedAt','updatedBy'])
        && d.keys().hasAll(['liveId','entries','status','updatedAt','updatedBy'])
        && d.liveId == liveId
        && d.status == 'pending'
        && d.updatedBy == request.auth.uid
        && d.updatedAt is timestamp
        && d.entries is list && d.entries.size() <= 40;
    }

    match /liveAssignments/{liveId} {
      allow read: if hasPermission('live.read') || hasPermission('kpi.read');
      allow create, update: if isAdmin() || (canTagAndDraft() && validAssignment(liveId));
      allow delete: if isAdmin();
    }

    match /liveKpiDrafts/{liveId} {
      allow read: if canTagAndDraft();
      allow create, update: if isAdmin() || (canTagAndDraft() && validDelegatedDraft(liveId));
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
